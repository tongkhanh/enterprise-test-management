{
  "name": "enterprise-test-management-system",
  "version": "1.0.0",
  "description": "Hệ thống Quản lý Kiểm thử Cấp Doanh nghiệp - Enterprise Test Management System (MERN Stack)",
  "main": "server.js",
  "scripts": {
    "test": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "monitoring:setup": "node scripts/setup-monitoring.js",
    "migrate:linear-collaboration": "node scripts/migrate-linear-collaboration.js",
    "start": "node server.js",
    "dev": "concurrently -k -n SERVER,CLIENT -c green,blue \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "nodemon server.js",
    "dev:client": "npm --prefix frontend run dev",
    "workers": "concurrently -k -n ENV,AUTO,INTEGRATION -c yellow,cyan,magenta \"node workers/environmentWorker.js\" \"node workers/automationWorker.js\" \"node workers/integrationWorker.js\"",
    "worker:environment": "node workers/environmentWorker.js",
    "worker:automation": "node workers/automationWorker.js",
    "worker:integration": "node workers/integrationWorker.js",
    "frontend:build": "npm --prefix frontend run build",
    "verify-models": "node verify-models.js",
    "check": "node scripts/check-project.js",
    "check:web-analyzer": "node scripts/check-web-analyzer.js",
    "check:automation": "node scripts/check-automation-runner.js",
    "check:workflow": "node scripts/check-workflow.js",
    "check:studio": "node scripts/check-react-studio.js",
    "check:ai-provider": "node scripts/check-ai-provider.js",
    "check:approval-batch": "node scripts/check-approval-batch.js",
    "check:step1": "node scripts/check-step1.js",
    "check:step2": "node scripts/check-step2.js",
    "check:step3": "node scripts/check-step3.js",
    "check:phase4": "node scripts/check-phase4.js",
    "check:integrations": "node scripts/check-integration-adapters.js",
    "check:audit-redaction": "node scripts/check-audit-redaction.js",
    "seed:fixed-accounts": "node scripts/seed-fixed-accounts.js"
  },
  "keywords": [
    "test-management",
    "qa",
    "enterprise",
    "mern",
    "mongodb",
    "mongoose"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.8",
    "cors": "^2.8.5",
    "dockerode": "^5.0.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "js-yaml": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.11.0",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "openai": "^4.77.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "playwright": "^1.62.1",
    "ua-parser-js": "^1.0.39",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "docx": "^9.5.1",
    "nodemon": "^3.1.9"
  }
}
