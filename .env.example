# ============================================================
# Enterprise Test Management System - Environment Variables
# ============================================================
# Copy file này thành .env và điền thông tin kết nối MongoDB Atlas
# cp .env.example .env
# ============================================================

# MongoDB Atlas Connection String
# Thay <username>, <password>, <cluster-url>, <database-name> bằng thông tin thực tế
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development
