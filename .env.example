# Server & database
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=enterprise_test_mgmt

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# CI/CD webhook (nếu để trống, endpoint không kiểm tra secret)
AUTOMATION_WEBHOOK_SECRET=replace-with-a-pipeline-secret

# AI - Gemini 3.5 Flash Free Tier qua Interactions API là provider mặc định
AI_PROVIDER=GoogleAI
AI_MODEL=gemini-3.5-flash
GEMINI_API_KEY=
AI_EMBEDDING_PROVIDER=GoogleAI
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_EMBEDDING_DIMENSIONS=1536

# OpenAI chỉ là provider tùy chọn, không bắt buộc
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
BUG_VECTOR_INDEX=bug_vector_index
KNOWLEDGE_VECTOR_INDEX=knowledge_vector_index

# Playwright Web Analyzer
# Danh sách domain phân cách bằng dấu phẩy. Hỗ trợ *.example.com. Để trống = mọi public host.
WEB_ANALYZER_ALLOWED_HOSTS=
WEB_ANALYZER_ALLOW_PRIVATE=false
WEB_ANALYZER_IGNORE_HTTPS_ERRORS=false
WEB_ANALYZER_BROWSER_EXECUTABLE=
WEB_ANALYZER_MAX_CONCURRENCY=2
WEB_ANALYZER_ARTIFACT_TTL_HOURS=24
WEB_ANALYZER_NAVIGATION_TIMEOUT_MS=30000
WEB_ANALYZER_ACTION_TIMEOUT_MS=10000

# User Story Documents (PDF/DOC/DOCX, tối đa 10 MB/tệp)
DOCUMENT_MAX_EXTRACTED_CHARS=500000
AI_DOCUMENT_CONTEXT_MAX_CHARS=50000

# Playwright Automation Runner
AUTOMATION_MAX_CONCURRENCY=2
AUTOMATION_NAVIGATION_TIMEOUT_MS=30000
AUTOMATION_ACTION_TIMEOUT_MS=10000
AUTOMATION_ARTIFACT_TTL_HOURS=72

# GitHub + Docker test environments
# Thư mục tạm để clone source trước khi docker build. Bỏ trống để dùng storage/environment-workspaces.
ENVIRONMENT_WORK_ROOT=
# Khi ETMS tự chạy trong Docker Compose, dùng host.docker.internal để truy cập container app đích.
DOCKER_TARGET_HOST=
KEEP_ENVIRONMENT_SOURCE=false
ENVIRONMENT_WORKER_CONCURRENCY=1
AUTOMATION_WORKER_CONCURRENCY=2
INTEGRATION_WORKER_CONCURRENCY=3

# Durable queues. Nếu bỏ trống, development fallback chạy trong process API.
REDIS_URL=
RUNNER_STORAGE_VOLUME=etms-storage

# Observability (Prometheus/Grafana/Loki). Token được tạo bằng npm run monitoring:setup.
METRICS_TOKEN_FILE=/run/secrets/metrics_token
GRAFANA_ADMIN_PASSWORD=change-this-before-running

# Jira Cloud - tạo Product Bug từ kết quả triage
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Bug

# Scheduled reports
REPORT_TIMEZONE=Asia/Bangkok
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ETMS <no-reply@example.com>

# URL giao diện dùng trong email mời thành viên
APP_BASE_URL=http://localhost:5000/studio

# Khóa riêng để mã hóa token Jira/GitHub/Linear (production nên dùng chuỗi ngẫu nhiên dài)
INTEGRATION_ENCRYPTION_KEY=
